  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/saida_harness_char_const.c" "saida_harness_char_const.c"))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "char_const.c"
  (alias "char_const.0.exec")
  (deps  "char_const.c"  (package frama-c)  (package "frama-c-saida")  (universe))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=saida    char_const.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=char_const.out.c")))
