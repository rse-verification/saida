  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=saida    char_const.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=char_const.out.c > \"char_const.0.res.log\" 2> \"char_const.0.err.log\"'"))
)
