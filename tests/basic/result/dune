(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=saida    bool_const.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=bool_const.out.c > \"bool_const.0.res.log\" 2> \"bool_const.0.err.log\"'"))
)
(rule
  (alias "bool_const.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/bool_const.0.res.oracle" "bool_const.0.res.log"))
)
(rule
  (alias "bool_const.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/bool_const.0.err.oracle" "bool_const.0.err.log"))
)
(alias (name "bool_const.diff")
  (deps (alias "bool_const.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
)
(alias (name "runtest_config")
  (deps (alias "bool_const.diff"))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
)
; TEST FILE "old_predicate.c"
(alias (name "old_predicate.wtests")
  (deps (alias "old_predicate.0.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "old_predicate.c")
  (deps (alias "old_predicate.0.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/basic/old_predicate.c
  (alias "old_predicate.0.exec.wtests")
  (targets "old_predicate.0.err.log" "old_predicate.0.res.log"  "old_predicate.out.c" "saida_harness_old_predicate.c" )
  (deps "old_predicate.0.exec.wtests" "../oracle/old_predicate.0.res.oracle" "../oracle/old_predicate.0.err.oracle"  "../oracle/old_predicate.out.c" "../oracle/saida_harness_old_predicate.c" "old_predicate.c"  (package frama-c)  (package "frama-c-saida") )
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (run frama-c-wtests -brief "old_predicate.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=saida    old_predicate.c -lib-entry -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=old_predicate.out.c > \"old_predicate.0.res.log\" 2> \"old_predicate.0.err.log\"" ))
)
(rule ; COMPARE TARGET #0 OF TEST #0 FOR TEST FILE "old_predicate.c"
  (alias old_predicate.0.exec.diff)
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/old_predicate.out.c" "old_predicate.out.c"))
)
(rule ; COMPARE TARGET #1 OF TEST #0 FOR TEST FILE "old_predicate.c"
  (alias old_predicate.0.exec.diff)
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/saida_harness_old_predicate.c" "saida_harness_old_predicate.c"))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "old_predicate.c"
  (alias "old_predicate.0.exec")
  (deps  "old_predicate.c"  (package frama-c)  (package "frama-c-saida")  (universe))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=saida    old_predicate.c -lib-entry -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=old_predicate.out.c")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "old_predicate.c"
  (alias "old_predicate.0.exec.show")
