(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=saida    old_predicate.c -lib-entry -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=old_predicate.out.c > \"old_predicate.0.res.log\" 2> \"old_predicate.0.err.log\"'"))
)
