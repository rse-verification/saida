(copy_files ../*.*)
(alias (name runtest)
  (deps (alias runtest_config)))
; TEST FILE "nondet-init.c"
(alias (name "nondet-init.wtests")
  (deps (alias "nondet-init.0.exec.wtests"))) ; to performs all sub-tests related to a file
(alias (name "nondet-init.c")
  (deps (alias "nondet-init.0.exec"))) ; to reproduce and visualize the all sub-test outputs related to a file
(rule ; TEST #0 OF TEST FILE tests/arrays/nondet-init.c
  (alias "nondet-init.0.exec.wtests")
  (targets "nondet-init.0.err.log" "nondet-init.0.res.log"  "nondet-init.out.c" "saida_harness_nondet-init.c" )
  (deps "nondet-init.0.exec.wtests" "../oracle/nondet-init.0.res.oracle" "../oracle/nondet-init.0.err.oracle"  "../oracle/nondet-init.out.c" "../oracle/saida_harness_nondet-init.c" "nondet-init.c"  (package frama-c)  (package "frama-c-saida") )
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (run frama-c-wtests -brief "nondet-init.0.exec.wtests" "frama-c -check -no-autoload-plugins -load-plugin=saida    nondet-init.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=nondet-init.out.c > \"nondet-init.0.res.log\" 2> \"nondet-init.0.err.log\"" ))
)
(rule ; COMPARE TARGET #0 OF TEST #0 FOR TEST FILE "nondet-init.c"
  (alias nondet-init.0.exec.diff)
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/nondet-init.out.c" "nondet-init.out.c"))
)
(rule ; COMPARE TARGET #1 OF TEST #0 FOR TEST FILE "nondet-init.c"
  (alias nondet-init.0.exec.diff)
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/saida_harness_nondet-init.c" "saida_harness_nondet-init.c"))
)
(rule ; REPRODUCE TEST #0 OF TEST FILE "nondet-init.c"
  (alias "nondet-init.0.exec")
  (deps  "nondet-init.c"  (package frama-c)  (package "frama-c-saida")  (universe))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (with-accepted-exit-codes 0 (system "frama-c -check -no-autoload-plugins -load-plugin=saida    nondet-init.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=nondet-init.out.c")))
)
(rule ; SHOW TEST COMMAND #0 OF TEST FILE "nondet-init.c"
  (alias "nondet-init.0.exec.show")
  (deps  "nondet-init.c"  (package frama-c)  (package "frama-c-saida")  (universe))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (system "echo 'frama-c -check -no-autoload-plugins -load-plugin=saida    nondet-init.c -lib-entry -main=func -saida -saida-tricera-opts=\"-acsl\" -saida-keep-tmp -saida-out=nondet-init.out.c > \"nondet-init.0.res.log\" 2> \"nondet-init.0.err.log\"'"))
)
(rule
  (alias "nondet-init.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/nondet-init.0.res.oracle" "nondet-init.0.res.log"))
)
(rule
  (alias "nondet-init.0.exec.diff")
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
(action (diff "../oracle/nondet-init.0.err.oracle" "nondet-init.0.err.log"))
)
(alias (name "nondet-init.diff")
  (deps (alias "nondet-init.0.exec.diff"))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
)
(alias (name "runtest_config")
  (deps (alias "nondet-init.diff"))
  (enabled_if (and true %{lib-available:frama-c-saida.core}))
)
